<% accent = @project.project_kind.color %>
<% content_for :title, page_title(@project.name) %>
<% content_for :description, @project.localized_tagline %>
<% content_for :og_title, @project.name %>
<% if (hero = @project.hero_screenshot)&.image&.attached? %>
  <% content_for :og_image do %>
    <meta property="og:image" content="<%= url_for(hero.image.variant(:large)) %>">
  <% end %>
<% end %>

<%# HEADER %>
<section class="page flex flex-col gap-6 pt-10 pb-12">
  <nav aria-label="Breadcrumb" class="flex flex-wrap gap-2 font-mono text-[13px] text-ink-faint">
    <%= link_to t("projects.show.breadcrumb_root"), projects_path, class: "text-ink-soft" %>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= @project.slug %></span>
  </nav>

  <div class="flex flex-wrap items-end justify-between gap-8">
    <div class="flex flex-[1_1_560px] flex-col gap-4.5">
      <div class="flex flex-wrap gap-2">
        <%= kind_badge @project.project_kind, extra: @project.platforms %>
        <%= meta_pill @project.status_label, dot_color: project_status_dot(@project) %>
      </div>
      <h1 class="font-display text-[clamp(56px,9vw,120px)] leading-[0.92] font-extrabold tracking-[-0.045em]"><%= @project.name %></h1>
      <p class="max-w-[620px] text-[clamp(18px,1.8vw,22px)] text-ink-soft text-pretty"><%= @project.localized_tagline %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <% if (download = @project.featured_download) %>
        <%= external_link_to download.url, class: "inline-flex min-h-[52px] items-center gap-2.5 rounded-[10px] px-6 font-semibold text-canvas", style: "background: #{accent}" do %>
          <%= render "shared/download_icon" %>
          <%= download.localized_label.presence || t("projects.show.download_for", platform: @project.platforms.presence || t("projects.show.download")) %>
        <% end %>
      <% end %>
      <% if @project.homepage_url.present? %>
        <%= external_link_to "#{URI.parse(@project.homepage_url).host&.delete_prefix("www.")} ↗", @project.homepage_url, class: "inline-flex min-h-[52px] items-center rounded-[10px] border border-line-bright px-5 font-medium" %>
      <% end %>
      <% if (source = @project.source_url.presence || @project.github_url) %>
        <%= external_link_to "#{t("projects.show.source_code")} ↗", source, class: "inline-flex min-h-[52px] items-center rounded-[10px] border border-line-bright px-5 font-medium" %>
      <% end %>
    </div>
  </div>
</section>

<%= render "projects/gallery", project: @project, accent: accent %>

<%# BODY + SIDEBAR %>
<section class="page flex flex-wrap gap-14 pb-24">
  <article class="flex min-w-0 flex-[999_1_560px] flex-col gap-12">
    <% if @project.localized_description.present? %>
      <div class="flex flex-col gap-4.5">
        <h2 class="font-display text-4xl font-bold tracking-[-0.02em]"><%= t("projects.show.about_title") %></h2>
        <div class="prose-project flex flex-col gap-4.5 text-lg text-ink-body text-pretty">
          <%= markdown @project.localized_description %>
        </div>
      </div>
    <% end %>

    <% if @project.features.any? %>
      <div class="flex flex-col gap-5">
        <h2 class="font-display text-4xl font-bold tracking-[-0.02em]"><%= t("projects.show.features_title") %></h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-3.5">
          <% @project.features.each do |feature| %>
            <div class="flex flex-col gap-2 rounded-[14px] border border-line-strong bg-surface p-5.5">
              <h3 class="text-[17px] font-semibold"><%= feature.localized_title %></h3>
              <p class="text-[15px] text-ink-soft"><%= feature.localized_body %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @project.updates.any? %>
      <%= render "projects/timeline", project: @project, accent: accent %>
    <% end %>
  </article>

  <%= render "projects/sidebar", project: @project, accent: accent %>
</section>

<% if @project.related_projects.any? %>
  <section aria-labelledby="related-heading" class="border-t border-line bg-band">
    <div class="page flex flex-col gap-6 pt-18 pb-22">
      <h2 id="related-heading" class="font-display text-[32px] font-bold tracking-[-0.02em]"><%= t("projects.show.related_title") %></h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(340px,100%),1fr))] gap-4">
        <% @project.related_projects.each do |related| %>
          <%= link_to project_path(related), class: "flex flex-col gap-2.5 rounded-2xl border border-line-strong bg-surface-raised p-6 transition-colors hover:border-line-bright" do %>
            <span class="self-start"><%= kind_badge related.project_kind %></span>
            <h3 class="font-display text-[23px] font-bold"><%= related.name %></h3>
            <p class="text-[15px] text-ink-soft"><%= related.localized_tagline %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
