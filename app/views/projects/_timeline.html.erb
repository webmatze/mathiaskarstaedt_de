<div class="flex flex-col gap-5">
  <div class="flex flex-wrap items-baseline justify-between gap-3">
    <h2 class="font-display text-4xl font-bold tracking-[-0.02em]"><%= t("projects.show.updates_title") %></h2>
    <% if project.github_connected? %>
      <%= external_link_to t("projects.show.all_releases"), "#{project.github_url}/releases",
            class: "text-[15px] font-medium", style: "color: #{accent}" %>
    <% end %>
  </div>

  <% latest = project.released_updates.first %>
  <ol class="m-0 flex list-none flex-col border-l-2 border-line-strong p-0">
    <% project.updates.each_with_index do |update, index| %>
      <% newest = update == latest %>
      <li class="relative flex flex-col gap-1.5 pl-7 <%= index == project.updates.size - 1 ? "pb-0" : "pb-8" %>">
        <% if update.planned? %>
          <span aria-hidden="true" class="absolute top-1.5 -left-[7px] box-border size-3 rounded-full border-2 border-dashed border-ink-ghost bg-canvas"></span>
        <% else %>
          <span aria-hidden="true" class="absolute top-1.5 -left-[7px] size-3 rounded-full"
                style="background: <%= newest ? accent : "#4A525A" %>"></span>
        <% end %>

        <span class="font-mono text-[13px]" style="color: <%= newest ? accent : "#9AA3AB" %>">
          <% if update.planned? %>
            <%= t("projects.show.planned") %>
          <% else %>
            <%= [ update.version, month_year(update.released_on), (t("projects.show.latest") if newest) ].compact_blank.join(" · ") %>
          <% end %>
        </span>

        <h3 class="text-[19px] font-semibold">
          <% if update.url.present? %>
            <%= external_link_to update.localized_title, update.url, class: "hover:underline" %>
          <% else %>
            <%= update.localized_title %>
          <% end %>
        </h3>

        <% if update.localized_body.present? %>
          <div class="prose-project text-[15px] text-ink-soft"><%= markdown update.localized_body %></div>
        <% end %>
      </li>
    <% end %>
  </ol>
</div>
