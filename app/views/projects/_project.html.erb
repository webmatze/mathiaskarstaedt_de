<%# The standard card in the "latest projects" grid. %>
<%= link_to project_path(project), class: "group flex min-h-[220px] flex-col gap-3 rounded-2xl border border-line-strong bg-surface-raised p-6 transition-colors hover:border-line-bright" do %>
  <div class="flex items-center justify-between gap-3">
    <%= kind_badge project.project_kind %>
    <span class="font-mono text-xs text-ink-faint"><%= month_year project.last_activity_at %></span>
  </div>

  <h3 class="font-display text-[23px] font-bold tracking-[-0.015em]"><%= project.name %></h3>
  <p class="flex-1 text-[15px] text-ink-soft text-pretty"><%= project.localized_tagline %></p>

  <div class="flex items-center justify-between gap-3 border-t border-line-strong pt-3">
    <span class="font-mono text-xs text-ink-meta"><%= project.tech_stack %></span>
    <span class="text-sm font-semibold text-accent-themed"><%= t("projects.card.details") %></span>
  </div>
<% end %>
