<%# The standard card in the "latest projects" grid. %>
<% screenshot = project.hero_screenshot if project.hero_screenshot&.image&.attached? %>
<%= link_to project_path(project), class: "group relative flex min-h-[220px] overflow-hidden rounded-2xl border border-line-strong bg-surface-raised transition-colors hover:border-line-bright" do %>
  <div class="flex min-w-0 flex-1 flex-col gap-3 p-6 <%= "sm:pr-[calc(20%+1.5rem)]" if screenshot %>">
    <div class="flex items-center justify-between gap-3">
      <%= kind_badge project.project_kind %>
      <span class="font-mono text-xs whitespace-nowrap text-ink-faint"><%= month_year project.last_activity_at %></span>
    </div>

    <h3 class="font-display text-[23px] font-bold tracking-[-0.015em]"><%= project.name %></h3>
    <p class="flex-1 text-[15px] text-ink-soft text-pretty"><%= project.localized_tagline %></p>

    <div class="flex items-center justify-between gap-3 border-t border-line-strong pt-3">
      <span class="font-mono text-xs text-ink-meta"><%= project.tech_stack %></span>
      <span class="text-sm font-semibold whitespace-nowrap text-accent-themed"><%= t("projects.card.details") %></span>
    </div>
  </div>

  <%= render "projects/screenshot_panel", project: project, screenshot: screenshot if screenshot %>
<% end %>
