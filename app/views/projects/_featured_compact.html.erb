<%# The smaller favourite cards stacked next to the hero card. %>
<% screenshot = project.hero_screenshot if project.hero_screenshot&.image&.attached? %>
<%= link_to project_path(project), class: "group relative flex flex-auto overflow-hidden rounded-[18px] border border-line-strong bg-surface transition-colors hover:border-line-bright" do %>
  <div class="flex min-w-0 flex-1 flex-col gap-3 px-7 py-6 <%= "sm:pr-[calc(20%+1.75rem)]" if screenshot %>">
    <div class="flex items-center justify-between gap-3">
      <%= kind_badge project.project_kind %>
      <span class="font-mono text-xs text-ink-faint"><%= project.tech_stack.presence || month_year(project.last_activity_at) %></span>
    </div>
    <h3 class="font-display text-[28px] font-bold tracking-[-0.02em]"><%= project.name %></h3>
    <p class="text-[15px] text-ink-soft text-pretty"><%= project.localized_tagline %></p>
  </div>

  <%= render "projects/screenshot_panel", project: project, screenshot: screenshot if screenshot %>
<% end %>
