<div class="flex flex-wrap items-center justify-between gap-4 pb-8">
  <h1 class="font-display text-4xl font-bold tracking-[-0.02em]"><%= t("admin.podcasts.index.title") %></h1>
  <%= link_to t("admin.podcasts.index.new"), new_admin_podcast_path, class: "inline-flex min-h-11 items-center rounded-[10px] bg-accent-themed px-4 font-semibold" %>
</div>

<% if @podcasts.any? %>
  <table class="w-full border-collapse text-left text-sm">
    <thead class="font-mono text-xs tracking-[0.06em] uppercase text-ink-faint">
      <tr class="border-b border-line-strong">
        <th class="py-3 pr-4 font-medium"><%= t("admin.podcasts.index.columns.title") %></th>
        <th class="py-3 pr-4 font-medium"><%= t("admin.podcasts.index.columns.episodes") %></th>
        <th class="py-3 pr-4 font-medium"><%= t("admin.podcasts.index.columns.german") %></th>
        <th class="py-3 pr-4 font-medium"><%= t("admin.podcasts.index.columns.feed") %></th>
        <th class="py-3 pr-4 font-medium"><%= t("admin.podcasts.index.columns.published") %></th>
        <th class="py-3"></th>
      </tr>
    </thead>
    <tbody>
      <% @podcasts.each do |podcast| %>
        <tr class="border-b border-line">
          <td class="py-3 pr-4">
            <%= link_to podcast.title, edit_admin_podcast_path(podcast), class: "font-medium hover:text-accent-themed" %>
          </td>
          <td class="py-3 pr-4 text-ink-soft"><%= podcast.published_episodes.size %> / <%= podcast.episodes.size %></td>
          <td class="py-3 pr-4 font-mono text-xs <%= podcast.translated_field_count(:de) == podcast.translatable_field_count ? "text-status-active" : "text-ink-meta" %>">
            <%= "#{podcast.translated_field_count(:de)}/#{podcast.translatable_field_count}" %>
          </td>
          <td class="py-3 pr-4 font-mono text-xs <%= podcast.feed_ready? ? "text-status-active" : "text-kind-desktop" %>">
            <%= podcast.feed_ready? ? t("admin.podcasts.feed.ready") : t("admin.podcasts.feed.incomplete") %>
          </td>
          <td class="py-3 pr-4"><%= podcast.published? ? "●" : "○" %></td>
          <td class="py-3 text-right">
            <%= link_to podcast.published? ? "↗" : "", podcast.published? ? podcast_path(podcast) : "#",
                  class: "px-2 text-ink-meta hover:text-ink-bright", title: podcast.title %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-ink-faint"><%= t("admin.podcasts.index.empty") %></p>
<% end %>
