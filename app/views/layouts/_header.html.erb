<header class="border-b border-line">
  <nav aria-label="<%= t("layout.main_navigation") %>" class="page flex flex-wrap items-center justify-between gap-4 py-[18px]">
    <%= link_to root_path, class: "flex items-center gap-3 font-mono text-[15px] font-medium" do %>
      <span class="inline-flex size-9 items-center justify-center rounded-lg bg-accent-themed text-sm font-bold" aria-hidden="true"><%= t("site.monogram") %></span>
      <span><%= t("site.name") %></span>
    <% end %>

    <div class="flex flex-wrap items-center gap-1 text-[15px]">
      <%= link_to t("layout.favourites"), "#{root_path}#favourites", class: "rounded-lg px-3.5 py-2.5 text-ink-soft hover:text-ink-bright" %>
      <%= link_to t("layout.all_projects"), projects_path, class: "rounded-lg px-3.5 py-2.5 text-ink-soft hover:text-ink-bright" %>
      <%= link_to t("layout.podcasts"), podcasts_path, class: "rounded-lg px-3.5 py-2.5 text-ink-soft hover:text-ink-bright" %>
      <%= external_link_to t("layout.elbcasts"), "https://elbcasts.dev/", class: "rounded-lg px-3.5 py-2.5 text-ink-soft hover:text-ink-bright" %>
      <%= link_to t("layout.about"), "#{root_path}#about", class: "rounded-lg px-3.5 py-2.5 text-ink-soft hover:text-ink-bright" %>
      <%= external_link_to "https://github.com/webmatze", class: "flex items-center gap-2 rounded-lg border border-line-bright px-4 py-2.5" do %>
        <%= render "shared/github_icon" %>
        <span><%= t("layout.github") %></span>
      <% end %>
    </div>
  </nav>
</header>
