<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || page_title(t("site.tagline")) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || t("site.tagline") %>">
    <meta name="theme-color" content="#0E1113">
    <meta property="og:site_name" content="<%= t("site.name") %>">
    <meta property="og:title" content="<%= content_for(:og_title) || t("site.owner") %>">
    <meta property="og:description" content="<%= content_for(:description) || t("site.tagline") %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <%= yield :og_image %>
    <meta name="twitter:card" content="summary_large_image">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/xml" href="<%= sitemap_path %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="--accent: <%= site_profile.accent_color %>">
    <a href="#content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-lg focus:bg-accent-themed focus:px-4 focus:py-2 focus:font-medium"><%= t("layout.skip_to_content") %></a>

    <%= render "layouts/header" %>

    <main id="content">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
